# === Advanced RAG — environment ===
# Swap this key later. Get one at https://console.groq.com/keys
GROQ_API_KEY=xxxxxxx

# --- Optional model overrides (defaults shown) ---
# Fast model: query rewriting + grounding validation (cheap, high rate limits)
LLM_FAST=openai/gpt-oss-20b
# Smart model: LLM reranking + final answer generation
# NOTE: llama-3.3-70b-versatile has tight free-tier limits (~30 req/min, 12K tokens/min).
# This pipeline fires several 70b calls per question (rerank batches + generate, x retries),
# so heavy use can 429. Drop to openai/gpt-oss-20b here if you hit rate limits.
LLM_SMART=openai/gpt-oss-120b

# Server port (used by app.py)
PORT=8000
