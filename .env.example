# ── LLM Provider ───────────────────────────────────────────────
# Groq API key (used if VLLM_BASE_URL is not reachable)
GROQ_API_KEY=xxxxxx
GROQ_MODEL_NAME=openai/gpt-oss-20b
GROQ_VISION_MODEL_NAME=llama-3.2-11b-vision-preview

# ── vLLM (self-hosted, optional) ───────────────────────────────
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VLLM_VISION_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct

# ── Backend Service ────────────────────────────────────────────
API_PORT=3003
LOG_LEVEL=INFO
